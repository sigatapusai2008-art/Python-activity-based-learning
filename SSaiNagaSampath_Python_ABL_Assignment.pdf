BT 1 0 0 1 5 355.2 Tm /F3 7.5 Tf 9.3 TL (balance = 5000) Tj T*  T* (while True:) Tj T* (    print\("\\\\n1. Deposit"\)) Tj T* (    print\("2. Withdraw"\)) Tj T* (    print\("3. Check Balance"\)) Tj T* (    print\("4. Exit"\)) Tj T*  T* (    choice = input\("Enter your choice: "\)) Tj T*  T* (    if choice == "1":) Tj T* (        amount = float\(input\("Enter deposit amount: "\)\)) Tj T*  T* (        if amount > 0:) Tj T* (            balance += amount) Tj T* (            print\("Deposit successful"\)) Tj T* (        else:) Tj T* (            print\("Invalid amount"\)) Tj T*  T* (    elif choice == "2":) Tj T* (        amount = float\(input\("Enter withdrawal amount: "\)\)) Tj T*  T* (        if amount <= 0:) Tj T* (            print\("Invalid amount"\)) Tj T* (        elif amount <= balance:) Tj T* (            balance -= amount) Tj T* (            print\("Withdrawal successful"\)) Tj T* (        else:) Tj T* (            print\("Insufficient balance"\)) Tj T*  T* (    elif choice == "3":) Tj T* (        print\("Current Balance:", balance\)) Tj T*  T* (    elif choice == "4":) Tj T* (        print\("Thank you for using the ATM"\)) Tj T* (        break) Tj T*  T* (    else:) Tj T* (        print\("Invalid choice"\)) Tj T* ET
